{
  "name": "pocket-realms",
  "version": "0.1.0",
  "private": true,
  "description": "Pocket Realms \u2014 a Jackbox-style local multiplayer fantasy RPG (5e-lite) played on phones with a shared main screen.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client-host",
    "client-phone"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun run build:host && bun run build:phone && bun run build:server",
    "build:host": "bunx --bun vite build --config client-host/vite.config.ts",
    "build:phone": "bunx --bun vite build --config client-phone/vite.config.ts",
    "build:server": "bun build server/src/index.ts --outdir dist/server --target bun --sourcemap=linked",
    "start": "bun run build && bun dist/server/index.js",
    "serve": "bun dist/server/index.js",
    "voice:setup": "bun scripts/voice-setup.mjs",
    "dev": "bun --watch server/src/index.ts --dev",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "bun scripts/sim.ts",
    "sim:ci": "bun scripts/sim.ts --ci",
    "ci": "bun run typecheck && bun test && bun run sim:ci"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/bun": "^1.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "packageManager": "bun@1.4.4"
}
